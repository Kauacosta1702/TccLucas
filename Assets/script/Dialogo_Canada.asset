  m_Script: {fileID: 11500000, guid: add8175faaba1ef4590039e14dd4c779, type: 3}
  m_Name: Dialogo_Canada
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: Lucas
    text: "Estrangeiro, voc\xEA finalmente acordou. Sabe onde estamos?"
    portrait: {fileID: 0}
  - characterName: fabio
    text: "N\xE3o tenho ideia... o \xFAltimo lugar que me lembro era a faculdade."
    portrait: {fileID: 0}
  - characterName: Lucas
    text: "Isso aqui \xE9 o mundo gerado pelo seu pr\xF3prio c\xF3digo. Cuidado com
      os bugs."
    portrait: {fileID: 0}
  - characterName: fabio
    text: "Bugs? Tipo monstros ou erros de l\xF3gica?"
    portrait: {fileID: 0}
  - characterName: lucas
    text: "Ambos. \xC9 melhor testar o seu sistema antes que eles nos apaguem!"
    portrait: {fileID: 0}
  - characterName: fabio
    text: faaaaaaaaaaa que triste
    portrait: {fileID: 0}
