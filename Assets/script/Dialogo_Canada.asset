%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: add8175faaba1ef4590039e14dd4c779, type: 3}
  m_Name: Dialogo_Canada
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: Camille
    text: "Ol\xE1, seja bem-vindo! Eu sou a Camille, muito prazer."
    portrait: {fileID: 0}
  - characterName: Lucas
    text: Oi! Prazer, eu sou o Lucas.
    portrait: {fileID: 0}
  - characterName: Camille
    text: "\xC9 a sua primeira vez aqui no meu restaurante?"
    portrait: {fileID: 0}
  - characterName: Lucas
    text: "Sim. Eu sou brasileiro e essa \xE9 a minha primeira vez no Canad\xE1."
    portrait: {fileID: 0}
  - characterName: Camille
    text: "Ah, que legal! Espero que esteja gostando de conhecer o pa\xEDs."
    portrait: {fileID: 0}
  - characterName: Lucas
    text: "Sim, estou gostando bastante. \xC9 tudo bem diferente do que eu estou
      acostumado."
    portrait: {fileID: 0}
  - characterName: Camille
    text: "E o que voc\xEA veio fazer aqui no Canad\xE1?"
    portrait: {fileID: 0}
  - characterName: Lucas
    text: "Eu estou estudando a culin\xE1ria de alguns pa\xEDses para buscar inspira\xE7\xF5es
      para o restaurante da minha fam\xEDlia."
    portrait: {fileID: 0}
  - characterName: Camille
    text: "Uau, que incr\xEDvel! Voc\xEA tamb\xE9m trabalha com culin\xE1ria."
    portrait: {fileID: 0}
  - characterName: Lucas
    text: "Sim, e eu estou ajudando a trazer algumas ideias novas para o card\xE1pio
      do restaurante."
    portrait: {fileID: 0}
  - characterName: Camille
    text: "Olha, Lucas, ent\xE3o eu tenho uma \xF3tima not\xEDcia para voc\xEA. Eu
      estou precisando de ajuda aqui no restaurante hoje, e j\xE1 que voc\xEA est\xE1
      querendo aprender..."
    portrait: {fileID: 0}
  - characterName: Lucas
    text: "\xC9 s\xE9rio? Eu adoraria ajudar!"
    portrait: {fileID: 0}
  - characterName: Camille
    text: Pois bien, hoje temos bastante coisa para fazer por aqui, haha.
    portrait: {fileID: 0}
  - characterName: Lucas
    text: Pode deixar, eu vou ajudar no que puder.
    portrait: {fileID: 0}
  - characterName: Camille
    text: "Ah, s\xF3 mais um detalhe: este \xE9 um restaurante vegetariano. Ent\xE3o,
      hoje n\xF3s vamos adaptar algumas receitas tradicionais canadenses para os
      nossos convidados."
    portrait: {fileID: 0}
  - characterName: Lucas
    text: "Ah, que \xF3timo! Eu sou vegetariano tamb\xE9m."
    portrait: {fileID: 0}
  - characterName: Camille
    text: "Que legal! Voc\xEA veio ao lugar certo. Vamos come\xE7ar?"
    portrait: {fileID: 0}
  - characterName: Camille
    text: "Ah, que \xF3timo! Eu sou vegetariano tamb\xE9m."
    portrait: {fileID: 0}
  - characterName: Camille
    text: "Ah, que \xF3timo! Eu sou vegetariano tamb\xE9m."
    portrait: {fileID: 0}
  - characterName: Lucas
    text: "Ah, que \xF3timo! Eu sou vegetariano tamb\xE9m."
    portrait: {fileID: 0}
  - characterName: Camille
    text: "Que legal! Voc\xEA veio ao lugar certo. Vamos come\xE7ar?"
    portrait: {fileID: 0}
  - characterName: Camille
    text: "Lucas, eu gostaria que voc\xEA me ajudasse a preparar o Nanaimo Bar, que
      \xE9 um doce t\xEDpico canadense. Ela \xE9 feita com uma base de bolacha, uma
      camada de creme e, por cima, uma cobertura de chocolate."
    portrait: {fileID: 0}
  - characterName: Lucas
    text: Ah, tudo bem! Onde ficam os ingredientes?
    portrait: {fileID: 0}
  - characterName: Camille
    text: "J\xE1 est\xE3o todos separados naquela bancada. Pode pegar o que precisar
      e come\xE7ar por l\xE1."
    portrait: {fileID: 0}
  - characterName: Lucas
    text: OK!
    portrait: {fileID: 0}
